{
	"name": "leaderboard-wordle",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"intent": {
		"skills": [
			"@tanstack/*"
		]
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"types": "wrangler types --include-runtime=false",
		"types:check": "wrangler types --check --include-runtime=false",
		"auth:schema": "bunx auth@latest generate --config ./src/server/auth/auth.generate.ts --output ./src/server/db/auth-schema.generated.ts --adapter drizzle --dialect postgresql -y",
		"auth:check": "cp src/server/db/auth-schema.generated.ts .cache/auth-check.before.ts && bun run auth:schema && bun ./scripts/check-auth-schema.ts .cache/auth-check.before.ts src/server/db/auth-schema.generated.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"word-list": "bun ./scripts/build-word-list.ts",
		"verify:bundle": "bun ./scripts/verify-bundle-secrecy.ts",
		"test:unit": "vitest run",
		"test:integration": "vitest run tests/integration",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260823.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-cloudflare": "^7.2.0",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.2.0",
		"@types/pg": "^8.23.1",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"pg": "^8.23.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.11",
		"wrangler": "^4.125.0"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"better-auth": "^1.7.1",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"hono": "^4.13.3",
		"zod": "^4.4.3"
	}
}
