{
	"name": "leaderboard-wordle",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"intent": {
		"skills": [
			"@tanstack/*"
		]
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"types": "wrangler types --include-runtime=false",
		"types:check": "wrangler types --check --include-runtime=false"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260823.1",
		"@sveltejs/adapter-cloudflare": "^7.2.0",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.2.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.125.0"
	}
}
