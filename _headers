# Deployed security headers for static assets (Phase-5 S5c).
# adapter-cloudflare merges this file with its autogenerated immutable
# headers block. The app-level nosniff contract (pages + API) lives in
# src/server/middleware/security-headers.ts; this extends it to the
# platform-served immutable assets (defense-in-depth).
/_app/*
  X-Content-Type-Options: nosniff