# Leaderboard Wordle — environment template
# Copy to .env (SvelteKit dev) and/or .dev.vars (wrangler dev). Never commit real values.

# --- Database (Neon) ---
# WebSocket endpoint — REQUIRED for interactive transactions (SELECT ... FOR UPDATE).
# The HTTP-only neon() one-shot driver is a different mechanism and must not replace this.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the app (used for cookie/redirect construction).
BETTER_AUTH_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google OAuth consent screen → Authorized redirect URI:
#   http://localhost:5173/api/auth/callback/google  (prod: https://<host>/api/auth/callback/google)

# --- Admin bootstrap (NG18) ---
# Project owner's verified Google email; first login promotes to admin (never demotes).
ADMIN_EMAIL=

# --- Wrangler (Cloudflare) ---
# Worker vars can also be declared in wrangler.toml [vars] or as Secrets in the dashboard;
# local wrangler dev reads .dev.vars.